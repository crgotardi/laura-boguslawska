---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import LauraBoguslawskaFull from '@assets/laura-boguslawska-full.png'
---

<Layout title="">
	<section>
		<div class="flex items-start">
			<div class="flex-1 flex justify-center flex-col">
				<h2 class="heading leading-none z-10 text-nowrap mb-10">
					Welcome to my profile!
				</h2>
				<p class="text-justify">
					My name is Laura, I come from Poland and currently live in Krakow.
					I have always been interested in art and it has been my greatest passion for years.
				</p>
				<br>
				<p class="text-justify">
					On the website I want to share with you what I create. 
					Painting, drawing and literature are extremely close to my heart,
				</p>
				<br>
				<p class="text-justify">
					Clatego, I recently decided to devote more time to them, which resulted in the creation of this website. 
					I hope you will find something for yourself here :)
				</p>
				<br>
				<p class="text-justify">
					Do you like what I do?
					<span class="font-bold text-blue-200">Let's talk!</span>
				</p>
			</div>
			<div class="flex-1 flex justify-end items-center">
				<Image 
					src={LauraBoguslawskaFull} 
					alt="Laura Boguslawska photo"
					width={400}
				/>
			</div>
		</div>
	</section>
</Layout>